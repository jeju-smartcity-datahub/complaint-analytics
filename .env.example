# =============================================================================
# 루트 docker-compose.yml 환경변수
#   cp .env.example .env   후 값을 채운다. (.env 는 커밋하지 않는다 — .gitignore 대상)
# ⚠️ 값 뒤에 주석을 붙이지 않는다 — 빈 값 뒤의 "# ..." 는 값으로 읽힌다.
# =============================================================================

# --- 접속 포트 (호스트) ---
# 브라우저 접속 주소 http://localhost:<WEB_PORT>
WEB_PORT=8080

# --- DB (이 compose 밖에서 미리 띄워 둔 PostgreSQL + PostGIS) ---
# host.docker.internal = 이 PC 에 떠 있는 DB (database/docker-compose.yml 기본 포트 25433).
# 원격 DB 면 그 호스트/포트를 쓴다. 계정은 database/.env 와 같게 맞춘다.
DB_HOST=host.docker.internal
DB_PORT=25433
DB_NAME=jeju_datahub
DB_USERNAME=jeju
DB_PASSWORD=jeju1234

# --- OIDC 로그인 [필수] ---
# OIDC_CLIENT_ID 가 비어 있으면 백엔드가 기동하지 않는다.
# OIDC_REDIRECT_URI 는 IdP 에 등록한 값과 문자 단위로 같아야 한다 (끝 슬래시 주의).
OIDC_ISSUER_URI=https://manager.project.dtonic.io:10443
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080
OIDC_END_SESSION_URI=https://manager.project.dtonic.io:10443/logout
FRONT_BASE_URL=http://localhost:8080
# http 접속이면 false, https 면 true
SESSION_COOKIE_SECURE=false

# --- 서비스 간 API 키 [필수] ---
# 임의 문자열 (예: openssl rand -hex 32). 비어 있으면 해당 API 가 503 으로 막힌다.
# INTERNAL_API_KEY: 배치 → 백엔드 / BATCH_API_KEY: 백엔드 → 배치 (운영 화면 /ops/batch)
INTERNAL_API_KEY=
BATCH_API_KEY=

# --- 배치 원천 자격증명 [잡 실행 시 필요, 기동에는 불필요] ---
DHUB_BASE_URL=https://manager.project.dtonic.io:10443
DHUB_USER_EMAIL=
DHUB_USER_PW=
# true 면 batch.tb_btch_schdl 의 cron 으로 잡이 자동 실행된다
BATCH_SCHEDULED=false

# --- VWorld [선택] ---
# VWORLD_API_KEY: 백엔드·배치 지오코딩 (서버 측 비밀)
VWORLD_API_KEY=
VWORLD_BASE_URL=https://api.vworld.kr
# VITE_VWORLD_*: 프론트 배경지도 (브라우저로 노출되는 공개 키)
VITE_VWORLD_API_KEY=
VITE_VWORLD_BASE_URL=

# --- AI 어시스턴트 [선택] ---
AGENT_API_BASE_URL=
AGENT_ID=
