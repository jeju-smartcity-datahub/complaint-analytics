<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jeju.datahub.dashboard.service.impl.DashboardPanelMapper">

    <!-- 컬럼(스네이크) -> VO(카멜) 매핑은 application.yml 의
         mybatis.configuration.map-underscore-to-camel-case=true 로 자동 처리.
         limit 은 #{} 바인딩(${} 미사용 → 인젝션 방어). 데이터 없으면 빈 리스트.

         집중구역(selectHotspots)은 여기서 걷어냈다 — 0행짜리 저장 결과 조회 대신
         실시간 군집 분석(analysis/HotspotAnalysisMapper.xml)에 위임한다. -->

    <!-- 1) 최근 분석 실행: excn_dt 내림차순 top N.
         TB_COM_CD 조인으로 분석유형명·상태명. 매칭 코드가 없어도 행이 빠지지 않게 LEFT JOIN.
         단, "분석 실행" 카드이므로 addl_atrb1(용도 구분)이 ANLS·BOTH 인 분석 5종만 남긴다
         — 보고서 전용 유형(CVLCPT 민원현황 · DASHBOARD)이 이 카드에 섞이면 안 된다.
         조건은 JOIN ON 이 아니라 WHERE 에 둔다: ON 에 두면 LEFT JOIN 이라 CVLCPT 행이 유형명만
         NULL 인 채로 그대로 남는다. 대신 ANLS_TYPE_CD 에 없는 미등록 코드도 함께 빠진다. -->
    <select id="selectRecentAnalyses" resultType="jeju.datahub.dashboard.service.AnalysisVO">
        SELECT
            a.excn_id       AS excn_id,
            a.anls_type_cd  AS anls_type_cd,
            t.cd_nm         AS anls_type_nm,
            a.excn_stts_cd  AS excn_stts_cd,
            s.cd_nm         AS excn_stts_nm,
            a.excn_dt       AS excn_dt,
            a.emd_cd        AS emd_cd,
            <!-- 정책 시뮬레이션 행 제목 재료(대시보드 카드 `{지역} · {방식} · {값}`).
                 🔴 전부 `->>`(text) 로만 꺼낸다 — 캐스팅하지 않으므로 값이 숫자가 아니어도 SQL 이 터지지 않는다.
                 해석·조합·폴백은 프론트(policySimRunTitle) 몫이다. 다른 유형·키 없음은 NULL. -->
            r.rslt_id                                    AS rslt_id,   <!-- 카드 행 → 시나리오 선택 키 -->
            r.anls_rng_cn                                AS anls_rng_cn,
            a.anls_param_json ->> 'plcyType'             AS plcy_type,
            a.anls_param_json ->> 'expandMethod'         AS expand_method,
            a.anls_param_json ->> 'addPkltSlot'          AS add_pklt_slot,
            a.anls_param_json ->> 'roadMtncType'         AS road_mtnc_type,
            a.anls_param_json ->> 'roadMtncLen'          AS road_mtnc_len,
            a.anls_param_json ->> 'feeAplcnMthd'         AS fee_aplcn_mthd,
            a.anls_param_json ->> 'feeIncrsRt'           AS fee_incrs_rt
        FROM parking.tb_anls_excn a
        LEFT JOIN parking.tb_com_cd t
               ON t.group_cd = 'ANLS_TYPE_CD' AND t.cd_vl = a.anls_type_cd
        LEFT JOIN parking.tb_com_cd s
               ON s.group_cd = 'EXCN_STTS_CD' AND s.cd_vl = a.excn_stts_cd
        <!-- 결과 행은 실행당 1행이 정상이지만 excn_id 에 UNIQUE 가 없다(ix_plcy_rslt_excn 은 일반 인덱스).
             평범한 JOIN 이면 중복 행이 LIMIT 을 갉아먹으므로 LATERAL + LIMIT 1 로 실행당 1행을 보장한다. -->
        LEFT JOIN LATERAL (
            SELECT x.rslt_id, x.anls_rng_cn
              FROM parking.tb_plcy_smlt_rslt x
             WHERE x.excn_id = a.excn_id
             ORDER BY x.rslt_id
             LIMIT 1
        ) r ON TRUE
        WHERE t.addl_atrb1 IN ('ANLS', 'BOTH')
        <!-- 🔴 내가 실행한 것만(유형과 무관). 화면이 넘기지 않는다 — 컨트롤러가 세션에서 정한다
             (PolicySimMapper.xml 의 excutr_id 조건과 같은 규칙). LEFT JOIN 이 여럿이라 ON 이 아니라 WHERE 에 둔다. -->
        AND a.excutr_id = #{userId}
        <!-- POLICY_SIM 은 결과 행(TB_PLCY_SMLT_RSLT)이 있는 실행만 낸다. 보고서 내보내기용 실행 행은
             결과 행이 없어 제목 재료가 비고, 내보낼 때마다 카드를 채운다. 다른 유형은 건드리지 않는다. -->
        AND (a.anls_type_cd &lt;&gt; 'POLICY_SIM'
             OR EXISTS (SELECT 1 FROM parking.tb_plcy_smlt_rslt x WHERE x.excn_id = a.excn_id))
        <!-- 화면이 한 유형만 볼 때 좁힌다(대시보드 분석 카드 = POLICY_SIM). null 이면 종전대로 5종. -->
        <if test="anlsTypeCd != null"> AND a.anls_type_cd = #{anlsTypeCd} </if>
        ORDER BY a.excn_dt DESC
        LIMIT #{limit}
    </select>

    <!-- 2) 최근 리포트: crt_ymd 내림차순 top N (NULL 은 뒤로).
         TB_COM_CD 조인으로 상태명. -->
    <select id="selectRecentReports" resultType="jeju.datahub.dashboard.service.ReportVO">
        SELECT
            r.rptp_id   AS rptp_id,
            r.rptp_nm   AS rptp_nm,
            r.stts_cd   AS stts_cd,
            s.cd_nm     AS stts_nm,
            r.file_fmt  AS file_fmt,
            r.crt_ymd   AS crt_ymd
        FROM parking.tb_rptp r
        LEFT JOIN parking.tb_com_cd s
               ON s.group_cd = 'RPTP_STTS_CD' AND s.cd_vl = r.stts_cd
        <where>
            <!-- 화면이 한 생성구분만 볼 때 좁힌다(대시보드 보고서 카드 = MANUAL).
                 null 이면 종전대로 전체다 — 기존 호출자(있다면)의 동작을 바꾸지 않는다.
                 ix_rptp_crt_type (crt_type, crt_ymd DESC) 를 정렬까지 함께 탄다. -->
            <if test="crtType != null"> AND r.crt_type = #{crtType} </if>
            <!-- 🔴 "남의 것" 만 뺀다. 조각은 report 네임스페이스에 두고 **FQ 로 include**
                 한다(복제하면 한쪽만 고쳐져 두 화면의 집합이 갈린다 — 카드는 목록의 축약이어야 한다).
                 🔴 ownerWhere 가 아니라 **ownerWhereRowwise** 다 — 여기 crtType 은 nullable 이고
                 OGNL 에서 `null != 'AUTO'` 가 true 라, ownerWhere 를 쓰면 crtType 미전송일 때
                 보이는 자동 생성 보고서까지 통째로 사라진다.
                 AUTO 도 이제 배포 부서·관리자 판정(autoVisible)을 거친다. 이 조각이 AUTO 행을 report 네임스페이스의
                 autoVisible 판정식(배포 부서 · ALL · 보고서 관리 메뉴 보유자)으로 거른다.
                 🔴 crt_type='MANUAL' 은 프론트(ReportPanel.tsx)가 정한다 — 백엔드가 강제하지 않는다. -->
            <include refid="jeju.datahub.report.service.impl.ReportMapper.ownerWhereRowwise"/>
        </where>
        ORDER BY r.crt_ymd DESC NULLS LAST
        LIMIT #{limit}
    </select>

    <!-- 3) AI 추천 질문: 노출 대상(expsr_yn=true), expsr_seq 오름차순 top N (NULL 은 뒤로). -->
    <select id="selectAiSuggestions" resultType="jeju.datahub.dashboard.service.SuggestionVO">
        SELECT
            faq_id,
            qstn
        FROM parking.tb_faq
        WHERE expsr_yn = true
        ORDER BY expsr_seq ASC NULLS LAST
        LIMIT #{limit}
    </select>

    <!-- 4) 시군구코드(5자리) → 시군구명. emd_cd 앞 5자리가 시군구 코드다.
         ⚠️ 미등록 코드면 결과가 없어 null 이 되고, 그러면 **전 지역**으로 분석된다 —
            화면 셀렉트가 2개뿐이라 실질 위험은 없지만, 넓힐 때는 검증을 붙인다. -->
    <select id="selectSggNm" resultType="string">
        SELECT max(a.sgg_nm)
          FROM parking.tb_admdst a
         WHERE left(a.emd_cd, 5) = #{sggCd}
    </select>

    <!-- 5) 데이터 최신 갱신일: 수집 배치별 마지막 **성공** 실행 시각.
         🔴 batch 스키마를 명시한다 — currentSchema 는 parking,public 이라 생략하면
            `relation "tb_btch_excn_hstry" does not exist` 가 된다. 백엔드가 batch 스키마를 읽는 첫 사례다.
         🔴 COMPLETED 만 센다. FAILED 는 부분 적재라 "갱신됐다" 고 내세울 수 없다(청크 커밋분이 남아도
            그것은 완결된 갱신이 아니다).
         ⚠️ ended_dt 우선 — 데이터가 완성된 시각이다. 비정상 종료로 비어 있으면 started_dt 로 떨어진다.
         ⚠️ 한 번도 안 돈 잡은 여기 결과에 없다 — 4행 고정은 서비스가 채운다. -->
    <select id="selectDataFreshness" resultType="jeju.datahub.dashboard.service.DataFreshnessItemVO">
        SELECT h.job_nm                                    AS job_nm,
               max(coalesce(h.ended_dt, h.started_dt))     AS last_excn_dt
          FROM batch.tb_btch_excn_hstry h
         WHERE h.status = 'COMPLETED'
           AND h.job_nm IN
        <foreach item="jobNm" collection="jobNms" open="(" separator="," close=")">#{jobNm}</foreach>
         GROUP BY h.job_nm
    </select>

</mapper>
