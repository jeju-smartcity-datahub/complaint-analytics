<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jeju.datahub.analysis.service.impl.ZoneRcmdtnMapper">

    <!-- 컬럼(스네이크) -> VO(카멜) 매핑은 application.yml 의
         mybatis.configuration.map-underscore-to-camel-case=true 로 자동 처리.
         모든 파라미터는 #{} 바인딩이다(${} 미사용 → 인젝션 방어) — 개월수 분모·최소 면수 하한까지
         상수를 SQL 에 박지 않는다. -->

    <!-- 읍면동 참고 지표: 민원 월평균(C0) + 단속 월평균(Enf) + 전환 가능 면수 + 기존 유료 면수.
         🔴 민원 기간(ocrn_dt)·단속 기간(crdn_dt) 둘 다 timestamp 라 반열림 구간이고 바인딩은
            LocalDateTime 이다 (ocrn_dt >= cvFrom AND ocrn_dt < cvToExcl / crdn_dt >= crdnFrom AND
            crdn_dt < crdnTo). BETWEEN … AND '2026-08-31' 로 적으면 종료일 00:00:00 이후가 통째로
            빠진다 — ZoneRcmdtnQueryParam 주석 참고.
         🔁 2026-10-12 — 기간 컬럼이 dclr_ymd(신고일자) 에서 ocrn_dt(발생일시) 로 바뀌었다.
            다른 민원 화면(대시보드·목록·집중구역·생활권·위험단계)이 전부 ocrn_dt 이고, dclr_ymd 는
            17,811건(18.5%)이 NULL 이라 어떤 기간을 골라도 그만큼이 빠졌다. 등가 창
            (ocrn_dt 2026-01-01~2026-09-01 excl = 옛 dclr_ymd 2025-01-01~2025-08-31)에서 40,875건으로
            행 집합이 동일하다 — 실측. 선례는 LifezoneSupplyMapper.xml 머리 주석 ②(2026-09-13).
            ⚠️ 대가: 화면에 보이는 날짜가 실제 발생일보다 1년 뒤다(다른 민원 화면이 이미 지던 성질).
         🔴 dclr_ymd IS NOT NULL 가드를 넣지 않는다 — 넣으면 살리려던 17,811건이 다시 빠진다.
         🔴 민원 창과 단속 창은 일부러 다른 구간이다 — 한쪽을 옮길 때 다른 쪽을 따라 옮기지 않는다.
         🔴 TB_ADMDST 를 기준으로 LEFT JOIN 하므로 원천이 0건인 동도 0 으로 남는다(목록에서 빠지지 않는다).
         분모 months·crdnMonths 가 소수(달별 조회 비율 합)라 jdbcType=NUMERIC 으로 받고, 배정률
            총건수용 원 건수 cvlcptCnt 를 함께 낸다(월평균 × 개월수 되곱 폐지). -->
    <select id="selectBaseline" resultType="jeju.datahub.analysis.service.ZoneRcmdtnBaselineVO">
        WITH c0 AS (
          SELECT emd_cd, COUNT(*) AS cvlcpt_cnt, COUNT(*)::numeric / #{months,jdbcType=NUMERIC} AS c0
            FROM parking.tb_cvlcpt
           WHERE cvlcpt_type_cd &lt;&gt; '99'             <!-- 🔴 유형 99 는 주차 민원이 아니다 -->
             AND ocrn_dt &gt;= #{cvFrom} AND ocrn_dt &lt; #{cvToExcl}   <!-- 🔴 반열림 -->
             AND emd_cd IS NOT NULL
           GROUP BY emd_cd),
        enf AS (
          SELECT emd_cd, COUNT(*)::numeric / #{crdnMonths,jdbcType=NUMERIC} AS enf
            FROM parking.tb_crdn_dsctn
           WHERE crdn_dt &gt;= #{crdnFrom} AND crdn_dt &lt; #{crdnTo} AND emd_cd IS NOT NULL
           GROUP BY emd_cd),
        slot AS (
          SELECT emd_cd,
                 SUM(CASE WHEN <include refid="convertibleLot"/> THEN pklt_cpcty ELSE 0 END) AS able_cpcty,
                 SUM(CASE WHEN prk_crg_yn = 'Y' AND extsh_dt IS NULL THEN pklt_cpcty ELSE 0 END) AS paid_cpcty
            FROM parking.tb_pblpklt WHERE emd_cd IS NOT NULL GROUP BY emd_cd)
        SELECT a.emd_cd, a.emd_nm, a.sgg_nm,
               COALESCE(c0.c0,0) AS cvlcptMmAvg, COALESCE(c0.cvlcpt_cnt,0) AS cvlcptCnt, COALESCE(enf.enf,0) AS crdnMmAvg,
               COALESCE(slot.able_cpcty,0) AS ableCpcty, COALESCE(slot.paid_cpcty,0) AS paidCpcty
          FROM parking.tb_admdst a
          LEFT JOIN c0 USING (emd_cd) LEFT JOIN enf USING (emd_cd) LEFT JOIN slot USING (emd_cd)
         ORDER BY a.sgg_nm, a.emd_nm
    </select>

    <!-- 선택한 읍면동 안의 후보 주차장 목록 + 최근접 배정 민원·단속 건수.
         🔴 배정은 "민원 1건 → 가장 가까운 후보 주차장 1곳" 이다(CROSS JOIN LATERAL … LIMIT 1) —
            반경 집계가 아니라 중복이 없다. 그래서 한 동의 asgnCvlcptCnt 합은 그 동의 좌표 보유
            민원 수를 넘지 않는다(ZoneRcmdtnMapperTest.noDoubleCountingWithinEmd 가 단언한다).
         🔴 배정은 읍면동 경계 안으로 가둔다 — lots·cv·crd 세 CTE 모두 scopeWhere(읍면동 또는 시군구)를
            걸고, 배정 LATERAL 에 동 일치 조건(l.emd_cd = cv.emd_cd / crd.emd_cd)을 건다.
            동 경계 밖 민원을 끌어오면 옆 동 민원으로 순위가 만들어진다.
            종전에는 세 CTE 에 emd_cd = #{emdCd} 를 직접 걸었다. 시군구 모드에서도
               배정은 동 경계를 유지한다 — 그래야 같은 주차장의 asgnCvlcptCnt 가 읍면동 실행과
               시군구 실행에서 <b>정확히 같다</b>. 읍면동 모드에서는 lots 가 한 동뿐이라 동 일치 조건이
               항상 참이고 결과가 종전과 같다.
         🔴 #{altmntRng} 는 geography 거리라 단위가 "미터" 다(ALTMNT_RNG_VL, 기본 300).
            값을 바꾸면 순위가 바뀐다 — 응답에 적용값을 담는 근거다.
         ⚠️ AS MATERIALIZED 는 의도를 못박는 장치이지 성능의 전부가 아니다. PostgreSQL 12+ 는 CTE 를
            2회 이상 참조하면 인라인하지 않으므로(여기 lots 는 3회 참조) 키워드 없이도 이미 materialize
            된다(2026-10-12 EXPLAIN 실측 99~141ms ↔ 102~110ms = 차이 없음).
            🔴 그래도 남긴다 — 나중에 참조가 1곳으로 줄면 인라인돼 민원·단속 건마다 lots 가 재평가되고,
               그때 조용히 느려지는 것을 막는다.
         🔴 cv·crd 가 geom::geography 를 쓰는 이유는 인덱스가 아니라 ST_SetSRID(ST_MakePoint(lot,lat))
            표현식을 행마다 다시 계산하지 않는 것이다(geom 은 stored 생성컬럼). 실제 플랜의 공간 술어는
            인덱스 없는 CTE lots 를 상대로 돈다 — 좌표 GiST(ix_tb_cvlcpt_geom 등)는 이미 있고 새로
            만들지 않는다(이 쿼리는 그것을 타지 않는다).
         ⚠️ tb_pblpklt 에는 geom 이 없다 — 후보 주차장은 수십 개소라 lots 쪽은
            ST_SetSRID(ST_MakePoint(...)) 를 그대로 둔다. 그리고 tb_pblpklt.lat/lot 은 NOT NULL 이라
            좌표 가드가 필요 없다(cv·crd 쪽은 nullable 이라 lat IS NOT NULL 이 필요하다). -->
    <!-- 🔴 민원 배정 CTE 3단(후보 주차장 → 좌표 보유 민원 → 최근접 배정)을 조각으로 묶는다 —
         selectLotRanking(건수 집계)과 selectLotTrend(월별·블록 집계)가 <b>같은 배정</b>을 보아야
         "월별 합 ≠ 최근 블록 건수" 로 갈리지 않는다. 한쪽만 고치는 것을 구조로 막는다.
         🔁 2026-10-13 cv 의 기간이 #{cvFrom}/#{cvToExcl} 고정에서 #{scanFrom}/#{scanToExcl}
            (ZoneRcmdtnQueryParam 의 파생 getter)로 바뀌었다. 🔴 범위를 그냥 넓히면 안 된다 —
            selectLotRanking 의 asgnCvlcptCnt(전 구간 배정 민원)가 2배가 되고 그 값이 정렬 기준이라
            순위가 통째로 바뀐다. 그래서 ranking 은 종전 민원 창, trend 만 '직전 동일 기간' 까지
            넓힌 범위를 넘긴다(trendScan 플래그). 🔴 lots·cv_asgn 의 배정 로직은 같게 유지한다. -->
    <!-- 분석 범위 조각. lots·cv·crd 세 CTE 가 이 하나를 include 한다(한쪽만 바뀌는 것을 막는다).
         emdCd 가 있으면 읍면동, 없으면 시군구 안 전 읍면동. 🔴 둘은 배타다 — 서비스가 정확히 하나만 채운다.
         🔴 sggNm 까지 null 이면 sgg_nm = NULL 이라 조용히 0행이다 — 입력 검증은 서비스가 먼저 끊는다.
         ⚠️ 컬럼을 한정하지 않는다(include 하는 세 CTE 의 FROM 이 각자 하나라 모호하지 않다). -->
    <sql id="scopeWhere">
        <choose>
            <when test="emdCd != null">emd_cd = #{emdCd}</when>
            <otherwise>emd_cd IN (SELECT emd_cd FROM parking.tb_admdst WHERE sgg_nm = #{sggNm})</otherwise>
        </choose>
    </sql>

    <sql id="lotsAndCvAsgn">
        lots AS MATERIALIZED (
          SELECT pklt_id, pklt_nm, pklt_type_nm, pklt_cpcty, pklt_addr, lat, lot,
                 emd_cd,                            <!-- 배정 동 일치 · 응답 emdCd -->
                 ST_SetSRID(ST_MakePoint(lot, lat),4326)::geography AS g
            FROM parking.tb_pblpklt
           WHERE <include refid="scopeWhere"/> AND <include refid="convertibleLot"/>),
        cv AS (
          SELECT geom::geography AS g,              <!-- 🔴 stored 생성컬럼 — 행마다 ST_MakePoint 재계산을 피한다 -->
                 emd_cd,                            <!-- 배정 동 일치 -->
                 ocrn_dt,                           <!-- 추세 블록 비교 단위가 월이 아니라 '날짜' 다 -->
                 to_char(ocrn_dt, 'YYYY-MM') AS ym  <!-- 🔴 월별 추이(trendMm)의 칸 이름 전용 — 블록 경계 판정에는 쓰지 않는다 -->
            FROM parking.tb_cvlcpt
           WHERE <include refid="scopeWhere"/> AND cvlcpt_type_cd &lt;&gt; '99'
             <!-- 호출하는 쿼리가 범위를 정한다(위 머리 주석). 🔴 반열림 -->
             AND ocrn_dt &gt;= #{scanFrom} AND ocrn_dt &lt; #{scanToExcl}
             AND lat IS NOT NULL),
        cv_asgn AS (                      <!-- 🔴 민원 1건 → 가장 가까운 주차장 1곳 -->
          SELECT n.pklt_id, cv.ym, cv.ocrn_dt FROM cv   <!-- 블록 경계 판정에 날짜가 필요하다 -->
          CROSS JOIN LATERAL (SELECT l.pklt_id, l.g FROM lots l
                               WHERE l.emd_cd = cv.emd_cd   <!-- 같은 읍면동 후보에만 배정 -->
                               ORDER BY l.g &lt;-&gt; cv.g LIMIT 1) n
           WHERE ST_DWithin(n.g, cv.g, #{altmntRng}))
    </sql>

    <select id="selectLotRanking" resultType="jeju.datahub.analysis.service.ZoneRcmdtnLotVO">
        WITH <include refid="lotsAndCvAsgn"/>,
        crd AS (
          SELECT geom::geography AS g,              <!-- 🔴 같은 이유 (GiST 를 타는 것이 아니다 — 위 주석) -->
                 emd_cd                             <!-- 배정 동 일치 -->
            FROM parking.tb_crdn_dsctn
           WHERE <include refid="scopeWhere"/> AND crdn_dt &gt;= #{crdnFrom} AND crdn_dt &lt; #{crdnTo}
             AND lat IS NOT NULL),
        crd_asgn AS (
          SELECT n.pklt_id FROM crd
          CROSS JOIN LATERAL (SELECT l.pklt_id, l.g FROM lots l
                               WHERE l.emd_cd = crd.emd_cd  <!-- 민원과 같은 동 일치 -->
                               ORDER BY l.g &lt;-&gt; crd.g LIMIT 1) n
           WHERE ST_DWithin(n.g, crd.g, #{altmntRng}))
        SELECT l.pklt_id, l.pklt_nm, l.pklt_type_nm, l.pklt_cpcty, l.pklt_addr,
               l.emd_cd, a.emd_nm,                  <!-- 두 모드 공통 · 하위 호환 추가 -->
               a.sgg_nm,                            <!-- 검토지수 기준값(시군구별 A·B)을 고르는 키 · 미매칭 NULL 이면 제주시 기준 + COEF_FALLBACK -->
               l.lat, l.lot,
               COALESCE(c.cnt,0) AS asgnCvlcptCnt,
               <!-- 추세 블록 2칸(asgnCvlcptCntRcnt·…Bfr)을 여기서 걷었다. 1차 '이전'
                    블록이 민원 창 <b>밖</b>이라 이 쿼리의 스캔 범위로는 셀 수 없고, 범위를 넓히면
                    정렬 기준인 asgnCvlcptCnt 가 2배가 된다(15-2). 네 칸은 selectLotTrend 가 내고
                    applyTrend 가 골라 채운다 — 블록 건수·월별 추이·증가율의 소유자가 한 곳이 됐다. -->
               COALESCE(d.cnt,0) AS asgnCrdnCnt,
               ROUND(COALESCE(c.cnt,0)::numeric / NULLIF(l.pklt_cpcty,0), 2) AS cvlcptPerSlot
          FROM lots l
          LEFT JOIN (SELECT pklt_id, count(*) cnt FROM cv_asgn GROUP BY 1) c USING (pklt_id)
          LEFT JOIN (SELECT pklt_id, count(*) cnt FROM crd_asgn GROUP BY 1) d USING (pklt_id)
          LEFT JOIN parking.tb_admdst a ON a.emd_cd = l.emd_cd   <!-- PK 조인이라 행이 불지 않는다 -->
         ORDER BY asgnCvlcptCnt DESC, l.pklt_cpcty DESC, l.pklt_id   <!-- 🔴 2차·3차 키 필수 · 결정적 입력 순서일 뿐, 최종 정렬은 계산기(추세 반영 검토지수)가 한다 -->
    </select>

    <!-- 추세 집계 — 주차장 × 연월로 묶고 <b>블록 네 칸</b>을 한 번에 센다.
         ① 1차   최근 = [bgng, end+1) D일   · 이전 = [bgng − D, bgng) D일
         ② 폴백  최근 = 마지막 D/2 일        · 이전 = 처음 D/2 일 (반 분할)
         🔴 한 쿼리로 내는 이유는 폴백 판정(= 1차 '이전' 블록의 동 전체 합이 0 인가)이 조회 결과에
            달려 있어서다. 쿼리를 두 번 쏘면 같은 스캔(최대 486일)을 두 번 한다.
         🔴 ym 은 <b>집계 칸 이름</b>으로만 쓴다 — 블록 경계 판정은 날짜 반열림이다. 그래서 양 끝
            달은 '부분 달' 이고, 1차 '이전' 블록의 달이 '최근' 블록의 달과 이름이 겹칠 수 있다
            (예: bgng=09-12 면 2026-09 가 양쪽에 있다). 🔴 칸이 갈려 있어 섞이지 않는다 —
            한 칸으로 합치면 그 달의 이전·최근이 뒤섞여 증가율이 조용히 틀린다.
         🔴 배정이 0 인 달은 행이 없다(1963-7 이 실제로 3행뿐이다) — 빈 달을 0 으로 채우는 것은
            서비스의 몫이다({@code TrendCountVO → TrendPointVO} 선례와 같다).
         ⚠️ jdbcType 을 적어 두는 이유: 창이 비어도(null) PostgreSQL 이 파라미터 타입을 추론할 수
            있어야 한다(없으면 MyBatis 가 OTHER 로 보내 타입 오류가 난다). ocrn_dt >= NULL 은
            거짓이라 그 경우 건수가 0 이다.
         🔴 selectLotRanking 과 같은 조각을 공유하므로 배정 정의가 갈리지 않는다 — 스캔 '범위' 만
            다르다(#{scanFrom}/#{scanToExcl} · 위 조각 머리 주석). -->
    <select id="selectLotTrend" resultType="jeju.datahub.analysis.service.impl.ZoneRcmdtnTrendCountVO">
        WITH <include refid="lotsAndCvAsgn"/>
        SELECT pklt_id, ym,
               count(*) FILTER (WHERE ocrn_dt &gt;= #{trendFrom,jdbcType=TIMESTAMP}
                                  AND ocrn_dt &lt; #{trendToExcl,jdbcType=TIMESTAMP}) AS cntRcnt,
               count(*) FILTER (WHERE ocrn_dt &gt;= #{bfrFrom,jdbcType=TIMESTAMP}
                                  AND ocrn_dt &lt; #{bfrToExcl,jdbcType=TIMESTAMP}) AS cntBfr,
               count(*) FILTER (WHERE ocrn_dt &gt;= #{splitTrendFrom,jdbcType=TIMESTAMP}
                                  AND ocrn_dt &lt; #{splitTrendToExcl,jdbcType=TIMESTAMP}) AS cntRcntSplit,
               count(*) FILTER (WHERE ocrn_dt &gt;= #{splitBfrFrom,jdbcType=TIMESTAMP}
                                  AND ocrn_dt &lt; #{splitBfrToExcl,jdbcType=TIMESTAMP}) AS cntBfrSplit
          FROM cv_asgn
         GROUP BY pklt_id, ym
         ORDER BY pklt_id, ym
    </select>

    <!-- 후보 밖 주차장 — 지도 회색 핀 전용. 순위·배정이 없는 평면 목록이다.
         🔴 범위(scopeWhere)·소멸(extsh_dt)·좌표 조건은 lots CTE 와 같고 convertibleLot 만 뒤집는다 —
            그래서 같은 param 이면 후보(selectLotRanking)와 겹치지 않고 합이 범위 내 전체와 같다.
         🔴 NOT (convertibleLot) 을 그대로 쓰지 않는다 — pklt_cpcty 가 NULL 이면 pklt_cpcty >= #{minCpcty}
            가 NULL 이라 NOT 도 NULL 이 되고 <b>행이 조용히 빠진다</b>(제주시 17행). COALESCE(…, false) 로
            NULL 을 "후보 아님" 으로 접는다.
         🔴 extsh_dt IS NULL 은 바깥에 따로 건다 — convertibleLot 안의 소멸 조건은 뒤집히면 "소멸분은
            후보 밖" 이 되어 지도에 없어진 주차장이 회색 핀으로 샌다.
         🔴 사유는 하나만, 우선순위 PAID > CPCTY_LACK(면수 NULL 포함) > PRVT > TYPE_EXCL.
            CASE 가 위에서부터 걸리므로 순서가 곧 우선순위다 — 줄 순서를 바꾸지 말 것.
            TYPE_EXCL 은 나머지(유형 범위 밖) — 앞 셋이 모두 거짓이면 convertibleLot 이 거짓인 이유는
            유형뿐이다.
         ⚠️ lat/lot 은 NOT NULL 이지만(위 lots 주석) 지도 전용 목록이라 가드를 남긴다. -->
    <select id="selectExclLots" resultType="jeju.datahub.analysis.service.ZoneRcmdtnExclLotVO">
        SELECT pklt_id, pklt_nm, pklt_cpcty, lat, lot,
               CASE WHEN COALESCE(prk_crg_yn,'N') = 'Y'                       THEN 'PAID'
                    WHEN pklt_cpcty IS NULL OR pklt_cpcty &lt; #{minCpcty}      THEN 'CPCTY_LACK'
                    WHEN COALESCE(ownshp_type_nm,'') = '민영'                  THEN 'PRVT'
                    ELSE 'TYPE_EXCL' END AS excl_rsn_cd
          FROM parking.tb_pblpklt
         WHERE <include refid="scopeWhere"/>
           AND extsh_dt IS NULL                     <!-- 🔴 소멸분 제외 — 바깥에서 따로(위 주석) -->
           AND lat IS NOT NULL AND lot IS NOT NULL
           AND NOT COALESCE((<include refid="convertibleLot"/>), false)   <!-- 🔴 NULL → 후보 아님 -->
         ORDER BY pklt_id
    </select>

    <!-- 🔴 후보 주차장(= 유료화 전환 대상) 조건. selectBaseline 의 가능 면수 집계와 후보
         주차장 목록이 이 조각 하나를 공유한다 — 한쪽만 바뀌면 "가능 면수 451면인데 목록 합이 397면"
         같은 어긋남이 생긴다.
         ⚠️ 유형 리터럴은 원천 문자열이고 코드그룹이 없어 상수로 둘 수밖에 없다.
            실측 유료 비중: 복층화 95.4% · 노외(공영) 43.5% · 공영 30.0% · 노상 4.1% · 공한지 1.9%.
         🔴 NARROW 가 기본인 이유가 그 비중이다 — 노상·공한지는 유료화 실적이 2~4% 라
            "유료화할 수 있는 자리" 로 세면 실행 불가능한 권고가 된다. -->
    <sql id="convertibleLot">
        COALESCE(prk_crg_yn,'N') = 'N'
        AND extsh_dt IS NULL                       <!-- 🔴 소멸분 제외 — 지도 핀이 없어진 주차장을 가리키면 안 된다 -->
        AND COALESCE(ownshp_type_nm,'') &lt;&gt; '민영'
        AND pklt_cpcty &gt;= #{minCpcty}
        <!-- 유형 범위는 화면 필터가 고른다 (0-6). 기본 NARROW.
             🔴 test 속성은 OGNL 이다 — 홑따옴표 리터럴이 1글자면 char 로 해석돼 문자열 비교가
                조용히 거짓이 되고, 예외 없이 <otherwise> 로 떨어진다(= 유형 필터가 먹지 않는다).
                'WIDE' 는 2글자 이상이라 String 으로 해석되며, 분기가 실제로 타는 것은
                ZoneRcmdtnMapperTest.wideWidensAbleCpcty()(이도이동 397 → 1128)가 JVM 으로 확인한다.
                🔴 새 조건을 1글자 리터럴('Y' 등)로 비교하지 말 것 — "WIDE".equals(trgtTypeSe) 꼴을 쓴다. -->
        <choose>
            <when test="trgtTypeSe == 'WIDE'">
                AND pklt_type_nm IN ('공영','노외(공영)','복층화','노상','노상(23년 조사)','공한지')
            </when>
            <otherwise>
                AND pklt_type_nm IN ('공영','노외(공영)','복층화')
            </otherwise>
        </choose>
    </sql>

</mapper>
