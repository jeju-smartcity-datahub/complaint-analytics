<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jeju.datahub.parking.service.impl.ParkingLotMapper">

    <!-- 컬럼(스네이크) -> VO(카멜) 매핑은 application.yml 의
         mybatis.configuration.map-underscore-to-camel-case=true 로 자동 처리.

         가이드 §4 결정: 단순 SELECT + 공통코드 LEFT JOIN 1건(🔁 2026-09-30 TSK-4167 로
         PKLT_TYPE_CD 조인이 붙었다). 좌표 NULL 행(lat OR lot IS NULL) 은 지오코딩
         미완료 — 지도에 못 놓으므로 응답에서 제외한다. extsh_dt 가 NOT NULL 인 행(소멸
         마킹된 행) 도 동일하게 화면에 나오면 안 되므로 제외한다.

         시군구 필터 (sggCd): 행정구역 매핑은 TB_PBLPKLT.emd_cd(8자리) 의 접두 5자리와
         대조 (TB_ADMDST 와 같은 패턴). 가이드 §1 의 TB_CVLCPT 매핑과 동일. -->

    <select id="selectParkingLots" resultType="jeju.datahub.parking.service.ParkingLotVO">
        SELECT
            p.pklt_id AS pkltId,
            p.pklt_nm AS pkltNm,
            p.lat     AS lat,
            p.lot     AS lot,
            <!-- 🔁 2026-09-21 TSK-4165 F8: 마커 팝업용 6컬럼(🔁 2026-09-30 TSK-4167 로
                 pklt_type_cd·cd_nm 이 더해져 4컬럼 → 6컬럼).
                 prk_crg_yn 은 char(1) — 패딩 없음(실측) -->
            p.pklt_addr  AS pkltAddr,
            p.emd_nm     AS emdNm,
            p.pklt_cpcty AS pkltCpcty,
            p.prk_crg_yn AS prkCrgYn,
            <!-- 🔁 2026-09-30 TSK-4167: 팝업 '주차장 유형' 행.
                 🔴 alias 는 pkltTypeNm 이지만 소스는 공통코드 cd.cd_nm 이다 —
                    같은 테이블의 p.pklt_type_nm(원천 원문: '노상(23년 조사)' 등)과 다른 값이다.
                    원문을 화면에 내리지 않는 이유는 계획서 D7.
                 🔴 pklt_type_cd 에 FK 가 없어 공통코드에 없는 값이면 cd_nm 이 null 이다 —
                    LEFT JOIN 을 쓰고, 프론트가 null 이면 행을 생략한다. -->
            p.pklt_type_cd AS pkltTypeCd,
            cd.cd_nm       AS pkltTypeNm
        FROM parking.tb_pblpklt p
        LEFT JOIN parking.tb_com_cd cd
               ON cd.group_cd = 'PKLT_TYPE_CD'
              AND cd.cd_vl    = p.pklt_type_cd
        WHERE p.lat IS NOT NULL
          AND p.lot IS NOT NULL
          AND p.extsh_dt IS NULL
        <if test="sggCd != null">
            AND LEFT(p.emd_cd, 5) = #{sggCd}
        </if>
        <!-- 🔁 2026-09-18 TSK-4162 (결정 D4-나): pklt_id 단독 정렬 → pklt_nm, pklt_id.
             마이그레이션 70 이 pklt_id 를 DB 채번 BIGINT IDENTITY 로 바꿨다. 그 번호는
             업무적 의미도 적재 순서도 아니라(ADD COLUMN 의 부여 순서는 보장되지 않는다)
             그대로 두면 화면 목록 순서가 이유 없이 뒤집힌 것처럼 보인다. 종전의 읍면동
             가나다순에 가까운 "이름순" 을 화면 계약으로 삼는다.
             🔴 pklt_id tie-breaker 는 필수다 — pklt_nm 은 유일하지 않다(2026-09-18 실측:
             중복 이름 46그룹·103행). 단독 정렬이면 같은 이름 안의 순서가 호출마다 달라진다. -->
        ORDER BY p.pklt_nm, p.pklt_id
    </select>

</mapper>